rules_version = '2';

// BOMNAL 아파트 갤러리 Firestore 보안 규칙
// - 읽기: 누구나 가능 (공개 갤러리)
// - 쓰기: Firebase Auth로 로그인한 관리자만 가능
service cloud.firestore {
  match /databases/{database}/documents {

    // 아파트 프로젝트 컬렉션
    match /apartments/{apartmentId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 공간 사진 서브컬렉션
      match /photos/{photoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 사이트 설정 (메인 이미지 등)
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
